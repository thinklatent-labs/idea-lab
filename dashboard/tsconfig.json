{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@kit/ui/*": ["./vendor/design-kit/packages/ui/src/*"],
      "@kit/kit": ["./vendor/design-kit/packages/design-kit/src/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
