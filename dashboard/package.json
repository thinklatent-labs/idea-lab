{
  "name": "idea-lab-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "node scripts/typecheck.mjs && vite build && node scripts/postbuild-artifact.mjs",
    "preview": "vite preview",
    "test": "node scripts/sync-data.mjs && vitest run",
    "validate": "node scripts/validate-register.mjs ../register/register.json",
    "typecheck": "node scripts/typecheck.mjs",
    "kit:pull": "node scripts/kit-pull.mjs",
    "kit:check": "node scripts/kit-pull.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.68.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "shadcn": "4.23.0",
    "style-dictionary": "5.1.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "4.1.12"
  }
}
